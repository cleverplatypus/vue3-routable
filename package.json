{
  "name": "@vue3-routable/core",
  "version": "1.2.0-beta.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleverplatypus/vue3-routable.git"
  },
  "description": "Small utility to annotate classes of objects to be activated/deactivated upon vue-router routes change ",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./internal": {
      "types": "./src/internal.d.ts",
      "default": "./src/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Nicola Dal Pont",
  "license": "MIT",
  "scripts": {
    "test": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:jsdoc": "typedoc && cp docs/api/README.md docs/api/index.md",
    "yalc:link:scoped-container": "yalc link scoped-container",
    "deprecate:legacy": "npm deprecate vue3-routable@\">=0.0.0\" \"Deprecated in favor of @vue3-routable/core\""
  },
  "prettier" : {
    "singleQuote": true,
    "semi": true
  },
  "dependencies": {
    "@types/lodash.get": "^4.4.9",
    "lodash.get": "^4.4.2"
  },
  "peerDependencies": {
    "vue": "^3.2.0",
    "vue-router": "^4.2.2"
  },
  "devDependencies": {
    "@babel/types": "^7.22.5",
    "@types/lodash.clonedeep": "^4.5.7",
    "@types/lodash.isequal": "^4.5.6",
    "@types/node": "^20.3.1",
    "@types/vue": "^2.0.0",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "cpx": "^1.5.0",
    "jsdom": "^25.0.1",
    "lodash.clonedeep": "^4.5.0",
    "lodash.isequal": "^4.5.0",
    "mini-signals": "^2.0.0",
    "ts-jest": "^29.1.1",
    "tsc": "^2.0.4",
    "typedoc": "^0.27.2",
    "typedoc-plugin-markdown": "^4.3.1",
    "typescript": "^5.8.3",
    "vitepress": "^1.3.4",
    "vitepress-jsdoc": "^1.0.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^1.8.1"
  }
}
